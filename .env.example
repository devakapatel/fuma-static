# --- Local development -------------------------------------------------------
# Optional: only needed when `next dev` should talk to a separately running
# `wrangler pages dev` instance. Leave unset in production (same origin).
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8788

# --- Cloudflare Pages (set in the dashboard, NOT committed) -----------------
# SESSION_SECRET=<32+ random bytes; signs the HttpOnly session cookie>
# ADMIN_TOKEN=<random token used to call /api/admin/users>
# CHAT_ENDPOINT=https://api.kilo.ai/api/gateway/v1
# CHAT_MODEL=deepseek/deepseek-v4-flash-0731:free
# SITE_URL=https://t9.pages.dev
# ALLOWED_ORIGIN=http://localhost:3000   # only needed for cross-origin dev

# --- Razorpay ----------------------------------------------------------------
# Create these in Dashboard -> Account & Settings -> API Keys.
# Test keys start with rzp_test_. Use live keys only after verification.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
#
# Dashboard -> Account & Settings -> Webhooks:
#   URL:    https://<your-site>/api/payments/webhook
#   Events: payment_link.paid  (qr_code.credited is still handled for legacy intents)
#   Secret: a long random string; must match RAZORPAY_WEBHOOK_SECRET.
# RAZORPAY_WEBHOOK_SECRET=...

# The D1 binding (`DB`) is configured in wrangler.toml and must also be
# available to the Pages project (database: t9-auth).
